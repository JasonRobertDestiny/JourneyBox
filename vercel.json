{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_DEEPWISDOM_API_KEY": "@deepwisdom_api_key",
    "REACT_APP_DEEPWISDOM_BASE_URL": "@deepwisdom_base_url",
    "REACT_APP_DEEPWISDOM_MODEL": "@deepwisdom_model",
    "REACT_APP_UNSPLASH_API_KEY": "@unsplash_api_key"
  }
}
