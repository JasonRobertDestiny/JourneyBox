{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_SILICONFLOW_API_KEY": "@siliconflow_api_key",
    "REACT_APP_SILICONFLOW_BASE_URL": "@siliconflow_base_url",
    "REACT_APP_SILICONFLOW_MODEL": "@siliconflow_model",
    "REACT_APP_UNSPLASH_API_KEY": "@unsplash_api_key"
  }
}
